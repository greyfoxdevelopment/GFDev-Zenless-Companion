<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>ZenlessCompanionSetup</AssemblyName>
    <AssemblyTitle>Zenless Companion Setup</AssemblyTitle>
    <Product>Zenless Companion</Product>
    <RootNamespace>ZenlessCompanionSetup</RootNamespace>
    <Version>1.0.0</Version>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon>..\src\Resources\zzz.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\LICENSE" LogicalName="ZenlessCompanionSetup.LICENSE" />
  </ItemGroup>

</Project>
